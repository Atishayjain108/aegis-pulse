export AEGIS_ENV=development
export AEGIS_DISABLE_OLLAMA=1
export AEGIS_AGENT_HMAC_KEY=dev-hmac-key-not-for-prod
export AEGIS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
export AEGIS_EXECUTE_MODE=advisory
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
# Auto-activate uv venv if present
if [ -f ".venv/bin/activate" ]; then
  source .venv/bin/activate
fi
