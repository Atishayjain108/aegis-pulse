# =====================================================================
# AEGIS Pulse — environment configuration
# =====================================================================
# Copy to `.env` (`cp .env.example .env`) and edit the lines marked
# REQUIRED. Every other variable has a working default.
#
# Every variable is read by `aegis.config.Settings`. If you add a new
# one to Settings, add it here too — and document it in COSTS.md if it
# touches a paid service.
#
# Lines starting with `#` are comments. Empty lines are ignored.
# Values do NOT need quotes unless they contain `#`, spaces, or `=`.
# =====================================================================

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
AEGIS_ENV=dev                          # dev | staging | prod | test
AEGIS_SERVICE_NAME=aegis-pulse
AEGIS_SERVICE_VERSION=0.1.0
# AEGIS_INSTANCE_ID defaults to your hostname; override for multi-process boxes.

# ---------------------------------------------------------------------
# Logging / observability
# ---------------------------------------------------------------------
AEGIS_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
AEGIS_LOG_FORMAT=console               # console (human) | json (machine)
AEGIS_LOG_JSON=false
AEGIS_PROMETHEUS_PORT=9464
# AEGIS_SENTRY_DSN=                    # optional; self-hosted Sentry
# AEGIS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------
# Postgres (REQUIRED — the docker-compose stack starts a matching DB)
# ---------------------------------------------------------------------
AEGIS_PG_DSN=postgresql://aegis_app:aegis_app_dev_pw@localhost:5433/aegis
AEGIS_PG_POOL_MIN_SIZE=2
AEGIS_PG_POOL_MAX_SIZE=16
AEGIS_PG_STATEMENT_TIMEOUT_MS=30000
AEGIS_PG_APPLICATION_NAME=aegis-pulse

# Variables consumed by the Postgres container (compose interpolates these).
POSTGRES_USER=aegis_app
POSTGRES_PASSWORD=aegis_app_dev_pw
POSTGRES_DB=aegis
POSTGRES_MIGRATE_USER=aegis_migrate
POSTGRES_MIGRATE_PASSWORD=aegis_migrate_dev_pw

# ---------------------------------------------------------------------
# Redis (REQUIRED)
# ---------------------------------------------------------------------
AEGIS_REDIS_URL=redis://localhost:6380/0
AEGIS_REDIS_NAMESPACE=aegis

# ---------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------
AEGIS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------
# MinIO (S3-compatible object store)
# ---------------------------------------------------------------------
AEGIS_MINIO_ENDPOINT=localhost:9002
AEGIS_MINIO_ACCESS_KEY=aegis-dev-key
AEGIS_MINIO_SECRET_KEY=aegis-dev-secret-please-change
AEGIS_MINIO_SECURE=false
AEGIS_MINIO_REGION=us-east-1
AEGIS_MINIO_BUCKET_RAW=aegis-raw
AEGIS_MINIO_BUCKET_FEATURES=aegis-features
AEGIS_MINIO_BUCKET_MODELS=aegis-models
AEGIS_MINIO_BUCKET_BACKUPS=aegis-backups

# Compose-side MinIO root creds (these MUST match access/secret above).
MINIO_ROOT_USER=aegis-dev-key
MINIO_ROOT_PASSWORD=aegis-dev-secret-please-change

# ---------------------------------------------------------------------
# Scrape
# ---------------------------------------------------------------------
AEGIS_SCRAPE_FLARESOLVERR_URL=http://localhost:8191/v1
AEGIS_SCRAPE_FLARESOLVERR_TIMEOUT_SECONDS=60
# AEGIS_SCRAPE_PROXY_POOL_PATH=./config/proxies.yaml
# AEGIS_SCRAPE_USER_AGENT_POOL_PATH=./config/user_agents.yaml
AEGIS_SCRAPE_DEFAULT_CONCURRENCY=4
AEGIS_SCRAPE_RESPECT_ROBOTS_TXT=true

# ---------------------------------------------------------------------
# Reddit (PRAW). Required for the Reddit adapter.
# Create a script app at https://www.reddit.com/prefs/apps to get keys.
# ---------------------------------------------------------------------
# AEGIS_REDDIT_CLIENT_ID=
# AEGIS_REDDIT_CLIENT_SECRET=
AEGIS_REDDIT_USER_AGENT=aegis-pulse/0.1 (by /u/your-reddit-username)

# ---------------------------------------------------------------------
# YouTube Data API v3
# Free tier: 10000 quota units / day. Get one at
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# ---------------------------------------------------------------------
# AEGIS_YOUTUBE_API_KEY=
AEGIS_YOUTUBE_DAILY_QUOTA_UNITS=10000

# ---------------------------------------------------------------------
# Alerts (all optional — system runs fine with none configured)
# ---------------------------------------------------------------------
AEGIS_ALERT_NTFY_URL=https://ntfy.sh
# AEGIS_ALERT_NTFY_TOPIC=aegis-pulse-yourname-CHANGE-ME
# AEGIS_ALERT_TELEGRAM_BOT_TOKEN=
# AEGIS_ALERT_TELEGRAM_CHAT_ID=
# AEGIS_ALERT_DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Compose-side Grafana credentials (NOT read by aegis.config — used by
# the Grafana container only).
# ---------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=aegis_dev_admin_pw

# =====================================================================
# Phase 2 — Multi-Agent Intelligence Layer
# =====================================================================

# ---------------------------------------------------------------------
# Agent messaging (HMAC signing for inter-agent Redis Streams messages)
# Required in production. In dev the system falls back to an insecure
# default key and logs a loud warning.
# ---------------------------------------------------------------------
# AEGIS_AGENT_HMAC_KEY=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------
# LLM providers — routing order: Ollama → Groq → OpenRouter → Gemini
# All are optional. Agents fall back to the deterministic heuristic
# path when no provider is available (pipeline always produces a result).
# ---------------------------------------------------------------------

# Ollama (local, free) — enabled by default; set to 1 to disable.
# AEGIS_DISABLE_OLLAMA=0
# OLLAMA_BASE_URL=http://localhost:11434

# Groq (free tier — generous rate limits, fast inference)
# Get a key at https://console.groq.com/
# GROQ_API_KEY=

# OpenRouter (multi-model proxy, pay-per-token)
# Get a key at https://openrouter.ai/
# OPENROUTER_API_KEY=

# Gemini (Google AI, free tier available)
# Get a key at https://aistudio.google.com/
# GEMINI_API_KEY=
# GOOGLE_API_KEY=     # alternative to GEMINI_API_KEY

# ---------------------------------------------------------------------
# Semantic memory (ChromaDB — Phase 2 HISTORIAN agent analogues store)
# Default: /var/lib/aegis/chroma. Override for a shared volume.
# ---------------------------------------------------------------------
# AEGIS_CHROMA_DIR=/var/lib/aegis/chroma

# Embedding model (sentence-transformers). Change only if you have GPU
# capacity for a larger model. Falls back to hash-embedding if the
# model cannot be loaded (no quality change for the heuristic pipeline).
# AEGIS_EMBED_MODEL=BAAI/bge-small-en-v1.5
