# =============================================================================
# .env.example — Phase 11 LLM environment variables
# =============================================================================
#
# Copy to .env and fill in values.
# Lines marked # REQUIRED must be set for that feature to work.
# All others have working defaults for local-only operation.
#
# NEVER commit .env to git. It is in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Ollama (local — primary path — REQUIRED for LLM-powered features)
# ---------------------------------------------------------------------------
# Start Ollama: ollama serve
# Pull models: make pull-models
AEGIS_OLLAMA_BASE_URL=http://localhost:11434
AEGIS_OLLAMA_MODEL=qwen2.5:14b
AEGIS_OLLAMA_EMBED_MODEL=bge-m3
AEGIS_OLLAMA_CODER_MODEL=qwen2.5-coder:14b

# Set to true in tests/CI to skip Ollama
AEGIS_DISABLE_OLLAMA=false

# ---------------------------------------------------------------------------
# vLLM (local GPU — optional, requires NVIDIA GPU)
# ---------------------------------------------------------------------------
AEGIS_ENABLE_VLLM=false
AEGIS_VLLM_BASE_URL=http://localhost:8001
AEGIS_VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct

# ---------------------------------------------------------------------------
# Groq (free cloud burst — sign up at https://console.groq.com)
# ---------------------------------------------------------------------------
# AEGIS_GROQ_API_KEY=gsk_...
AEGIS_GROQ_API_KEY=
AEGIS_GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# OpenRouter (free model pool — sign up at https://openrouter.ai)
# ---------------------------------------------------------------------------
# AEGIS_OPENROUTER_API_KEY=sk-or-...
AEGIS_OPENROUTER_API_KEY=
AEGIS_OPENROUTER_MODEL=mistralai/mistral-small-3

# ---------------------------------------------------------------------------
# Google Gemini (free tier — get key at https://aistudio.google.com)
# ---------------------------------------------------------------------------
# AEGIS_GEMINI_API_KEY=AIza...
AEGIS_GEMINI_API_KEY=
AEGIS_GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Paid providers (optional — high-stakes decisions only)
# ---------------------------------------------------------------------------
AEGIS_ANTHROPIC_API_KEY=
AEGIS_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Gateway behaviour
# ---------------------------------------------------------------------------
AEGIS_LLM_TIMEOUT_S=120.0
AEGIS_LLM_TEMPERATURE=0.2
AEGIS_LLM_MAX_TOKENS=2048
AEGIS_SEMANTIC_ROUTER_THRESHOLD=0.82
AEGIS_ENABLE_GUARDRAILS=true

# ---------------------------------------------------------------------------
# Prompt templates
# ---------------------------------------------------------------------------
AEGIS_PROMPT_TEMPLATE_DIR=src/aegis/llm/prompts/templates

# ---------------------------------------------------------------------------
# LiteLLM proxy (if using the proxy service)
# ---------------------------------------------------------------------------
AEGIS_LITELLM_MASTER_KEY=sk-litellm-dev-key-not-for-prod

# ---------------------------------------------------------------------------
# Cost tracking
# ---------------------------------------------------------------------------
# Set to 0 for unlimited; will log warning when exceeded
AEGIS_LLM_COST_BUDGET_USD_DAILY=0.0
