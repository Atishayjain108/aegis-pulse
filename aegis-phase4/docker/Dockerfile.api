# syntax=docker/dockerfile:1.6
#
# AEGIS Pulse — Phase 4 API image
# -------------------------------------------------------------------------
# Multi-stage build:
#   * `builder` resolves the wheel set (deterministic via uv if a lockfile
#     is provided; pip otherwise) into a virtual environment.
#   * `runtime` is the slim final image — Python + the venv + the source,
#     non-root user, tini as PID 1.
#
# Build:
#   docker build -f docker/Dockerfile.api -t aegis/execute-api:0.4.0 .
#
# Run:
#   docker run --rm -p 8200:8200 \
#     -e AEGIS_EXECUTE_MODE=advisory \
#     -e AEGIS_PG_DSN=postgresql://... \
#     -e AEGIS_REDIS_URL=redis://... \
#     aegis/execute-api:0.4.0
# -------------------------------------------------------------------------

# --------------------------------------------------------------------- build
FROM python:3.12-slim-bookworm AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Build-essential + libpq for asyncpg's optional binary wheel fallback.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        ca-certificates \
        curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m venv /opt/venv \
 && . /opt/venv/bin/activate \
 && pip install --upgrade pip wheel setuptools \
 && pip install ".[serve,db,redis,prometheus]"

# ------------------------------------------------------------------- runtime
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app/src \
    AEGIS_EXECUTE_API_HOST=0.0.0.0 \
    AEGIS_EXECUTE_API_PORT=8200

# tini for proper signal handling and zombie reaping. libpq for asyncpg.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        tini \
        libpq5 \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1000 aegis \
 && useradd  --system --uid 1000 --gid aegis --create-home --shell /bin/bash aegis

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=aegis:aegis src ./src
COPY --chown=aegis:aegis docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER aegis
EXPOSE 8200

# Healthcheck hits /healthz which never reads the DB.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${AEGIS_EXECUTE_API_PORT}/healthz" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["api"]
