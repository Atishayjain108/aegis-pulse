# ─── AEGIS Command Center Dashboard ────────────────────────────────────────
# Multi-stage: builder installs deps via uv into a venv, runtime is lean.
# Port: 8300

ARG PYTHON_VERSION=3.12

# ── Stage 1: dependency builder ──────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install uv==0.5.7

WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src

# Install the package with predict extra (provides fastapi + uvicorn)
RUN uv pip install --python /opt/venv/bin/python --no-cache-dir "/app[predict]"

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends curl tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/src /app/src

WORKDIR /app

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

EXPOSE 8300

HEALTHCHECK --interval=10s --timeout=2s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8300/healthz || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["uvicorn", "aegis.dashboard.app:app", "--host", "0.0.0.0", "--port", "8300", "--log-level", "warning"]
