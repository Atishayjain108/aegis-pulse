# ============================================================
# AEGIS Pulse — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in all values marked # REQUIRED
#   3. NEVER commit .env to git (it is in .gitignore)
#   4. For production: encrypt with SOPS:
#      sops --encrypt --input-type dotenv --output-type yaml .env > .env.sops.yaml
#      then commit .env.sops.yaml (safe — encrypted)
# ============================================================

# ── Phase 12: Security & Secrets ────────────────────────────────────────── #

# REQUIRED: JWT signing secret (minimum 32 characters)
# Generate with: openssl rand -hex 32
AEGIS_SEC_JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32

# REQUIRED: HMAC key for inter-service message signing
# Generate with: openssl rand -hex 32
AEGIS_SEC_HMAC_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# Vault address (default: local dev-mode)
AEGIS_SEC_VAULT_ADDR=http://127.0.0.1:8200

# Vault token (dev mode default — CHANGE IN PRODUCTION)
AEGIS_SEC_VAULT_TOKEN=dev-root-token

# Vault dev mode (true = in-memory, auto-unsealed; false = production)
AEGIS_SEC_VAULT_DEV_MODE=true

# JWT settings
AEGIS_SEC_JWT_ACCESS_TTL_MINUTES=15
AEGIS_SEC_JWT_REFRESH_TTL_DAYS=7
AEGIS_SEC_JWT_ALGORITHM=HS256
AEGIS_SEC_JWT_ISSUER=aegis-pulse

# PII scrubbing
AEGIS_SEC_PII_ENABLED=true
AEGIS_SEC_PII_SPACY_MODEL=en_core_web_sm

# Rate limiting
AEGIS_SEC_RATE_LIMIT_ENABLED=true
AEGIS_SEC_RATE_LIMIT_DEFAULT_RPM=60
AEGIS_SEC_RATE_LIMIT_BURST=10

# Audit logging
AEGIS_SEC_AUDIT_LOG_PATH=/var/log/aegis/audit.jsonl
AEGIS_SEC_AUDIT_MINIO_BUCKET=aegis-audit
AEGIS_SEC_AUDIT_ROTATION_HOURS=24

# CORS (comma-separated allowed origins)
AEGIS_SEC_CORS_ORIGINS=["http://localhost:8300","http://localhost:5173"]

# Redis (used for rate-limiting and JWT revocation)
AEGIS_SEC_REDIS_URL=redis://localhost:6380/0

# SOPS age key file path
AEGIS_SEC_SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt

# TLS cert paths (generated by mkcert — see bootstrap/security/03_mkcert_tls.sh)
AEGIS_SEC_TLS_CERT_PATH=certs/server.crt
AEGIS_SEC_TLS_KEY_PATH=certs/server.key

# ── Phase 0-1: Database & Infrastructure ────────────────────────────────── #

# PostgreSQL connection string
# REQUIRED for Phases 1-4 to function
AEGIS_PG_DSN=postgresql://aegis_app:aegis_app_dev_pw@localhost:5433/aegis

# Redis URL
AEGIS_REDIS_URL=redis://localhost:6380/0

# MinIO
AEGIS_MINIO_ENDPOINT=http://localhost:9002
AEGIS_MINIO_ACCESS_KEY=aegis-dev-key
AEGIS_MINIO_SECRET_KEY=aegis-dev-secret-please-change

# ── Phase 0: Scrape adapters ─────────────────────────────────────────────── #

# Reddit OAuth (optional — RSS adapters work without keys)
AEGIS_REDDIT_CLIENT_ID=
AEGIS_REDDIT_CLIENT_SECRET=

# YouTube Data API v3 (optional)
AEGIS_YOUTUBE_API_KEY=

# ── Phase 2: LLM providers ──────────────────────────────────────────────── #
# Leave blank to use local Ollama (free, no API key needed)

# Groq (free tier: ~14k req/day)
AEGIS_GROQ_API_KEY=

# OpenRouter (free tier available)
AEGIS_OPENROUTER_API_KEY=

# Google Gemini (free tier available via AI Studio)
AEGIS_GEMINI_API_KEY=

# Disable local Ollama in CI/CD (set to 1 to skip)
AEGIS_DISABLE_OLLAMA=0

# ── Phase 4: Notifications ───────────────────────────────────────────────── #

# Telegram bot token (get from @BotFather)
AEGIS_TELEGRAM_BOT_TOKEN=

# Discord webhook URL
AEGIS_DISCORD_WEBHOOK_URL=

# ntfy topic (self-hosted or ntfy.sh)
AEGIS_NTFY_TOPIC=aegis-alerts
AEGIS_NTFY_SERVER=https://ntfy.sh

# ── Phase 4: Execute ─────────────────────────────────────────────────────── #

# HMAC key for Phase 4 (can be same as AEGIS_SEC_HMAC_KEY)
AEGIS_EXECUTE_HMAC_KEY=dev-hmac-key-not-for-prod

# Execute mode: advisory (default) or live
AEGIS_EXECUTE_MODE=advisory

# Default tenant UUID
AEGIS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── Environment ──────────────────────────────────────────────────────────── #

AEGIS_ENV=development

# Agent HMAC key (for Phase 2 inter-agent signing)
AEGIS_AGENT_HMAC_KEY=dev-agent-hmac-key-not-for-prod
